rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.data.uid == userId;
      allow delete: if false;
    }

    match /chats/{chatId} {
      allow get: if request.auth != null
                 && request.auth.uid in chatId.split('_');

      allow list: if request.auth != null
                  && request.auth.uid in resource.data.participants;

      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2
                    && chatId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1];

      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.participants == resource.data.participants;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
                    && request.auth.uid in chatId.split('_');

        allow create: if request.auth != null
                      && request.resource.data.keys().hasOnly(['senderId', 'text', 'imageUrl', 'createdAt', 'replyToId', 'replyToText', 'replyToSenderId', 'deleted'])
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 2000
                      && request.resource.data.createdAt == request.time
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        // Only the sender may "delete" (we hide the content, not remove the document).
        allow update: if request.auth != null
                      && request.auth.uid in chatId.split('_')
                      && resource.data.senderId == request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'text', 'imageUrl']);

        allow delete: if false;
      }
    }
  }
}
